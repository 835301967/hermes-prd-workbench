# Non-secret settings. ./workbench setup creates controlled secret files.
PRD_MODEL_PROVIDER=custom:workbench
PRD_MODEL_BASE_URL=https://api.example.invalid/v1
PRD_MODEL_NAME=configure-your-model
PRD_SECRETS_DIR=./.runtime/secrets
PRD_BOOTSTRAP_ADMIN_USERNAME=maintainer
PRD_WEB_BIND=127.0.0.1
PRD_WEB_PORT=8180
PRD_TELEMETRY_ENABLED=false
PRD_TELEMETRY_RETENTION_DAYS=30

# Native development only. Compose uses its internal service addresses.
PRD_DB_URL='jdbc:mysql://127.0.0.1:3306/prd_workbench?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
PRD_DB_USERNAME=prd_workbench
PRD_DB_PASSWORD_FILE=./.runtime/secrets/db-password
PRD_UPLOAD_DIR=./.runtime/uploads
PRD_HERMES_BASE_URL=http://127.0.0.1:8643
PRD_HERMES_API_KEY_FILE=./.runtime/secrets/hermes-api-key
PRD_PLUGIN_KEY_FILE=./.runtime/secrets/plugin-key
PRD_MODEL_API_KEY_FILE=./.runtime/secrets/model-api-key
PRD_BOOTSTRAP_ADMIN_PASSWORD_FILE=./.runtime/secrets/admin-password
PRD_SERVER_PORT=18100
PRD_SERVER_ADDRESS=127.0.0.1
PRD_CONTROL_PLANE_URL=http://127.0.0.1:18100
PRD_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
NO_PROXY=127.0.0.1,localhost,::1
